# NextAuth v5
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=super-secret-development-key-change-this-in-production-min32chars
AUTH_SECRET=super-secret-development-key-change-this-in-production-min32chars

# Cloudinary
